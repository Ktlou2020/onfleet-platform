{
  "name": "onfleet-backend",
  "version": "1.0.0",
  "description": "OnFleet Africa Rent-to-Own Platform Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node-pg-migrate up",
    "dev": "nodemon src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "TEST_DATABASE_URL=postgresql://localhost/onfleet_test vitest run",
    "seed": "node src/seed.js",
    "reset-admin": "node src/reset-admin.js",
    "campaign:password-reset-special": "node src/scripts/password-reset-special-audience.js",
    "bike:update-status": "node src/scripts/update-bike-status.js",
    "bike:update-statuses-csv": "node src/scripts/update-bike-statuses-from-csv.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@aws-sdk/client-s3": "^3.1111.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.0.1",
    "file-type": "^22.0.1",
    "heic-convert": "^2.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^8.0.7",
    "pdf-parse": "^1.1.1",
    "pg": "^8.22.0",
    "tesseract.js": "^5.1.1",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
